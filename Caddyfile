:{$PORT:8080} {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    @scanners {
        path /wp-admin* /wp-content* /wp-includes* /wp-* /cgi-bin* /admin* /ALFA_DATA* *.php
        path /.env* /.git* /secrets.json /config.json /service-account.json
    }

    # SILENT SLAM: Drops the bot connection completely without answering
    abort @scanners

    # Clean reverse proxy leveraging Caddy 2.8.4's implicit defaults
    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    handle {
        root * /app/publish/build
        try_files {path} /index.html
        file_server
    }

    log {
        format json
    }
}

